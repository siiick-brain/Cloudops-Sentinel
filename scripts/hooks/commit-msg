#!/bin/sh

if grep -qiE '^[[:space:]]*Co-authored-by:' "$1"; then
    echo "Commit rejected: Co-authored-by trailers are not allowed." >&2
    exit 1
fi

author_email=${GIT_AUTHOR_EMAIL:-$(git config user.email)}
if [ "$author_email" != "devasoka38@gmail.com" ]; then
    echo "Commit rejected: author email must be devasoka38@gmail.com." >&2
    exit 1
fi
