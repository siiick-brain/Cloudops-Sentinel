#!/bin/sh

if grep -qiE '^[[:space:]]*Co-authored-by:' "$1"; then
    echo "Commit rejected: Co-authored-by trailers are not allowed." >&2
    exit 1
fi

author_email=${GIT_AUTHOR_EMAIL:-$(git config user.email)}
case "$author_email" in
    devasoka38@gmail.com|187153867+siiick-brain@users.noreply.github.com) ;;
    *)
        echo "Commit rejected: author email must be the owner's Gmail or GitHub noreply address." >&2
        exit 1
        ;;
esac
